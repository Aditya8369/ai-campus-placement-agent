{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://localhost:5000/",
        "http://localhost:5000/login",
        "http://localhost:5000/dashboard"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.70 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }]
      }
    }
  },
  "budgets": {
    "description": "Lighthouse CI audit budget thresholds for core candidate-facing pages (#859). Any decrease in scores or relaxation of budgets requires a documented reason in CONTRIBUTING.md.",
    "targets": {
      "/": {
        "name": "Landing Page",
        "authenticated": false,
        "budgets": {
          "performance": 0.70,
          "accessibility": 0.90,
          "best-practices": 0.85
        }
      },
      "/login": {
        "name": "Login Page",
        "authenticated": false,
        "budgets": {
          "performance": 0.70,
          "accessibility": 0.90,
          "best-practices": 0.85
        }
      },
      "/dashboard": {
        "name": "Dashboard Page",
        "authenticated": true,
        "budgets": {
          "performance": 0.70,
          "accessibility": 0.90,
          "best-practices": 0.85
        }
      }
    }
  }
}
