# ==============================================================================
# AI Campus Placement Agent - Environment Configuration (.env.example)
# Copy this file to .env and configure your environment-specific settings.
# All values below are safe placeholders. Never commit actual secret keys or API tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Security Settings
# ------------------------------------------------------------------------------
# Flask secret key used for cryptographically signing sessions and CSRF tokens.
# Generate a strong key in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=replace_with_a_secure_random_flask_secret_key

# Administrative secret key required for accessing maintenance and backup endpoints
ADMIN_SECRET_KEY=replace_with_a_secure_admin_secret_key

# Flask environment mode: development or production
FLASK_ENV=development

# ------------------------------------------------------------------------------
# Google Gemini AI Model Configuration
# ------------------------------------------------------------------------------
# Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
# Note: You can explore the platform without an API key using Demo Mode (/demo).
GEMINI_API_KEY=your_gemini_api_key_here

# Central Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# Transient Error Retry & Exponential Backoff Settings (#155, #497)
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY=1.0
GEMINI_RETRY_BACKOFF_FACTOR=2.0
GEMINI_RETRY_MAX_DELAY=10.0
GEMINI_RETRY_JITTER=true

# Request timeout in seconds on every AI call to prevent hanging (default: 30.0s) (#497)
GEMINI_REQUEST_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Privacy & PII Protection Settings (#295, #500)
# ------------------------------------------------------------------------------
# When true, redacts phone numbers, emails, and street addresses before AI model submission
ENABLE_PII_REDACTION=true

# ------------------------------------------------------------------------------
# Upload & Document Validation Constraints
# ------------------------------------------------------------------------------
# Maximum allowed resume upload file size in megabytes (default: 5 MB)
MAX_UPLOAD_SIZE_MB=5

# Minimum extractable text length required from PDF resumes (default: 100 characters)
MIN_PDF_TEXT_CHARS=100

# Optional local OCR fallback (pytesseract) for scanned PDFs (default: false)
ENABLE_OCR_FALLBACK=false

# ------------------------------------------------------------------------------
# Rate Limiting & Abuse Prevention (Sliding Window In-Memory)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=5/hour
RATE_LIMIT_INTERVIEW=30/hour
RATE_LIMIT_BATCH=10/hour
RATE_LIMIT_OUTREACH=20/hour
RATE_LIMIT_STAR=30/hour
RATE_LIMIT_DEFAULT=100/minute

# ------------------------------------------------------------------------------
# Session Security & Inactivity Timeout
# ------------------------------------------------------------------------------
# User inactivity duration in minutes before automatic logout (default: 30)
SESSION_TIMEOUT_MINUTES=30
# Countdown warning duration in seconds shown to user before expiration (default: 120)
SESSION_WARNING_SECONDS=120

# ------------------------------------------------------------------------------
# Analysis Result Input Hash Caching (#296)
# ------------------------------------------------------------------------------
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Structured Logging Configuration (#301)
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Logging format: key_value or json
LOG_FORMAT=key_value

# ------------------------------------------------------------------------------
# Email Notifications & SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
EMAIL_DELIVERY_DISABLED=true
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
NOTIFICATION_SENDER_EMAIL=notifications@example.com

# ------------------------------------------------------------------------------
# User Feedback Configuration
# ------------------------------------------------------------------------------
MAX_FEEDBACK_COMMENT_LENGTH=500
