# Flask Secret Key - Generate a secure random key for production
FLASK_SECRET_KEY=your_flask_secret_key_here

# Gemini API Key - Get from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting & Abuse Prevention (Issue #160)
# Format: "<count>/<unit>" where unit can be second, minute, hour, or day (e.g. 5/hour, 30/hour)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=5/hour
RATE_LIMIT_INTERVIEW=30/hour
RATE_LIMIT_BATCH=10/hour
RATE_LIMIT_OUTREACH=20/hour
RATE_LIMIT_STAR=30/hour
RATE_LIMIT_DEFAULT=100/minute

# Resume Upload File Size & Type Validation (Issue #153)
# Maximum resume upload file size in megabytes (default: 5 MB)
MAX_UPLOAD_SIZE_MB=5
# Scanned / Image-Only PDF Detection & OCR Fallback (Issue #154)
# Minimum extractable text length required from PDF resumes (default: 100 characters)
MIN_PDF_TEXT_CHARS=100
# Optional local OCR fallback (pytesseract). Disabled by default.
ENABLE_OCR_FALLBACK=false
# Gemini API Transient Error Retry & Exponential Backoff Settings (Issue #155)
# Transient errors (429 rate limit, 500/503 server errors, network timeouts) are retried automatically.
# Permanent errors (400 bad request, 401/403 invalid credentials) fail fast without retry.
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY=1.0
GEMINI_RETRY_BACKOFF_FACTOR=2.0
GEMINI_RETRY_MAX_DELAY=10.0
GEMINI_RETRY_JITTER=true

